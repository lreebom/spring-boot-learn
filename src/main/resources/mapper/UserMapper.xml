<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.lreebom.springbootlearn.mapper.UserMapper">
    <select id="selectById" resultType="com.lreebom.springbootlearn.model.entity.User">
        select id, username, email, create_time, update_time
        from user
        where id = #{id}
    </select>

    <select id="selectByUsername" resultType="com.lreebom.springbootlearn.model.entity.User">
        select id, username, email, create_time, update_time
        from user
        where username = #{username}
    </select>

    <select id="selectByEmail" resultType="com.lreebom.springbootlearn.model.entity.User">
        select id, username, email, create_time, update_time
        from user
        where email = #{email}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        insert into user (username, email)
        values (#{username}, #{email})
    </insert>

    <select id="selectPage" resultType="com.lreebom.springbootlearn.model.entity.User">
        select id, username, email, create_time, update_time
        from user
        order by create_time desc
        limit #{offset}, #{limit}
    </select>

    <select id="count" resultType="java.lang.Long">
        select count(*)
        from user
    </select>

    <update id="update" parameterType="com.lreebom.springbootlearn.model.entity.User">
        update user
        set username = #{username},
            email    = #{email}
        where id = #{id}
    </update>

    <delete id="deleteById">
        delete
        from user
        where id = #{id}
    </delete>
</mapper>